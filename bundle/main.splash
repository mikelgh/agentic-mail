}

fn parse_time_to_comparable(raw_time) {
    let parts = raw_time.split(",")
    if parts.len() < 2 { return "000000000000" }
    let date_part = parts[1].trim()
    let segs = date_part.split(" ")
    if segs.len() < 4 { return "000000000000" }
    let day = segs[0]
    let month_str = segs[1]
    let year = segs[2]
    let time_str = segs[3]
    let month_map = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"]
    let month = "00"
    for i in 0..month_map.len() {
        if month_map[i] == month_str {
            let m = i + 1
            month = if m < 10 { "0" + m.to_string() } else { m.to_string() }
            break
        }
    }
    let day_pad = if day.len() == 1 { "0" + day } else { day }
    let time_parts = time_str.split(":")
    let hh = if time_parts.len() >= 1 { time_parts[0] } else { "00" }
    let mm = if time_parts.len() >= 2 { time_parts[1] } else { "00" }
    return year + month + day_pad + hh + mm
}

fn sort_emails_by_time(emails) {
    let n = emails.len()
    if n <= 1 { return emails }
    for i in 0..n {
        for j in 0..(n - i - 1) {
            let t1 = parse_time_to_comparable(emails[j].email.time)
            let t2 = parse_time_to_comparable(emails[j + 1].email.time)
            if t1 < t2 {
                let tmp = emails[j]
                emails[j] = emails[j + 1]
                emails[j + 1] = tmp
            }
        }
    }
    return emails
}