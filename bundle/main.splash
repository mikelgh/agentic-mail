fn load_demo_data() {
    demo_mode = true
    account = {id: "demo" name: "演示账户" address: "demo@octosense.app"}
    analyzed_emails = []
    set_status("演示模式 · 分析中...")
    demo_batch(0)
}

// 逐封分析拆到独立帧：splash 每次脚本入口只有 64ms 墙钟预算
fn demo_batch(i) {
    let raws = demo_raws()
    if i >= raws.len() { set_status("演示模式"); pane("inbox"); ui.email_list.render(); return }
    analyzed_emails.push(analyze_email(raws[i]))
    start_timeout(0.01, || demo_batch(i + 1))
}

fn selftest(i) {
    let raws = demo_raws()
    if i >= raws.len() { println("[selftest] done"); return }
    let e = raws[i]
    let a = analyze_email(e)
    let cal = "0"
    if a.has_calendar_content { cal = "1" }
    let step = "0"
    if a.order.step >= 1 { step = "1" }
    if a.order.step >= 2 { step = "2" }
    if a.order.step >= 3 { step = "3" }
    println("[selftest] " + e.id + " cal=" + cal + " old=" + a.change.old + " new=" + a.change.new + " step=" + step + " no=" + a.order.order_no + " trk=" + a.order.tracking + " eta=" + a.order.estimated)
    start_timeout(0.01, || selftest(i + 1))
}

fn load_accounts() {
    host.request("mail.accounts", {}, fn(r) {
        if r.is_ok && r.data.len() > 0 {
            account = r.data[0]
            pane("inbox")
            sync_and_analyze()
        } else if r.is_ok {
            pane("welcome")
        } else {
            load_demo_data()
        }
    })
}

fn smart_connect() {
    let addr = ui.email_input.text().trim()
    let code = ui.pass_input.text().trim()
    if addr.len() == 0 { ui.welcome_note.set_text("请先填写邮箱地址"); return }
    if addr.search("@") < 0 { ui.welcome_note.set_text("邮箱地址格式不正确"); return }
    if code.len() == 0 { ui.welcome_note.set_text("请填写授权码（不是登录密码）"); return }
    ui.welcome_note.set_text("正在识别服务商并写入配置...")
    host.request("mail.add_account", {address: addr password: code}, fn(r) {
        if r.is_ok {
            ui.welcome_note.set_text("已连接 " + addr + "，正在同步邮件...")
            load_accounts()
        } else {
            ui.welcome_note.set_text("连接失败：" + r.error)
        }
    })
}

fn sync_and_analyze() {
    if account == nil || busy { return }
    if demo_mode { set_status("演示模式"); ui.email_list.render(); return }
    busy = true; set_status("正在同步...")
    host.request("mail.sync", {account: account.id folder: "INBOX"}, fn(r) {
        if r.is_ok { set_status("分析中..."); list_and_analyze() }
        else { set_status(r.error); busy = false }
    })
}
fn list_and_analyze() {
    host.request("mail.list", {account: account.id folder: "INBOX" offset: 0 limit: 20}, fn(r) {
        if r.is_ok { messages = r.data.messages; analyze_all_emails() }
        else { set_status(r.error); busy = false }
    })
}

fn analyze_all_emails() {
    analyzed_emails = []
    let pending = messages.len()
    if pending == 0 { set_status("收件箱为空"); busy = false; ui.email_list.render(); return }
    for m in messages {
        host.request("mail.message", {account: account.id folder: "INBOX" message: m.id}, fn(r) {
            if r.is_ok { analyze_one_real(r.data, pending) }
            if analyzed_emails.len() == pending { analyzed_emails = sort_emails_by_time(analyzed_emails); busy = false; set_status("分析完成"); ui.email_list.render() }
        })
    }
}

fn analyze_email(email) {
    let order = detect_order(email)
    let has_cal = detect_calendar(email)
    // 物流类邮件不当作日程事件
    if order.step > 0 { has_cal = false }
    let events = []
    let draft = ""
    let change = {old: "" new: "" source: ""}
    if has_cal {
        events = extract_events(email)
        change = extract_change(email)
        draft = make_draft(email, events, change)
    }
    return {email: email has_calendar_content: has_cal extracted_events: events reply_draft: draft change: change order: order is_read: email.is_read}
}

// LLM-powered analysis with rule-engine fallback
fn analyze_one_real(email, pending) {
    set_status("AI 分析中...")
    host.request("mail.analyze", {subject: email.subject from: email.from body: email.body}, fn(ar) {
        if ar.is_ok && ar.data != nil {
            analyzed_emails.push(analysis_from_llm(email, ar.data))
        } else {
            analyzed_emails.push(analyze_email(email))
        }
        if analyzed_emails.len() == pending { analyzed_emails = sort_emails_by_time(analyzed_emails); busy = false; set_status("分析完成"); ui.email_list.render() }
    })
}

// Map LLM response to the analysis structure expected by the UI
fn analysis_from_llm(email, a) {
    let events = []
    if a.events != nil {
        for e in a.events {
            events.push({title: e.title date: e.date time: e.time location: e.location source_email_id: email.id})
        }
    }
    let change = {old: "" new: "" source: ""}
    if a.change != nil && (a.change.old != "" || a.change.new != "") {
        change = {old: a.change.old new: a.change.new source: "llm"}
    }
    let order = {order_no: "" item: "" step: 0 tracking: "" estimated: ""}
    if a.order != nil && a.order.step > 0 {
        order = {order_no: a.order.order_no item: email.subject step: a.order.step tracking: a.order.tracking estimated: a.order.estimated}
    }
    let draft = a.reply_draft
    if draft == "" || draft == nil { draft = make_draft(email, events, change) }
    return {email: email has_calendar_content: a.is_calendar extracted_events: events reply_draft: draft change: change order: order is_read: email.is_read}
}

// 截取到最早出现的任意分隔字符（脚本无 slice，用逐字符 split 截断）
fn take_until_any(text, chars) {
    let out = text
    for c in chars.split("") {
        if c.len() > 0 {
            let parts = out.split(c)
            if parts.len() > 1 { out = parts[0] }
        }
    }
    return out
}

// split("") 拆成单字符字符串数组（Rust split("") 带首尾空元素，需过滤）
fn chars_of(s) {
    let parts = s.split("")
    let chars = []
    for c in parts { if c.len() > 0 { chars.push(c) } }
    return chars
}

// 取前 n 个字符：split("") 是原生调用不耗 VM 指令，只递归收集前 n 个非空元素。
// 不可用 chars_of 全量循环——真实邮件正文可达数万字符，O(len) VM 循环会撞 20M 指令预算
fn head_n(s, n) {
    return head_take(s.split(""), 0, n, "")
}
fn head_take(parts, i, n, acc) {
    if n <= 0 || i >= parts.len() { return acc }
    let c = parts[i]
    if c.len() > 0 { return head_take(parts, i + 1, n - 1, acc + c) }
    return head_take(parts, i + 1, n, acc)
}

// 取末尾 n 个字符：从数组尾部反向收集，同样 O(n)
fn tail_n(s, n) {
    let parts = s.split("")
    return tail_take(parts, parts.len() - 1, n, "")
}
fn tail_take(parts, i, n, acc) {
    if n <= 0 || i < 0 { return acc }
    let c = parts[i]
    if c.len() > 0 { return tail_take(parts, i - 1, n - 1, c + acc) }
    return tail_take(parts, i - 1, n, acc)
}

fn join_to(chars, i, end) {
    if i >= end { return "" }
    if i >= chars.len() { return "" }
    return chars[i] + join_to(chars, i + 1, end)
}

fn detect_calendar(email) {
    // 机器通知/安全/营销类邮件不是日程：主题或发件地址命中黑名单直接排除
    // （只查 subject+address，不查正文——正文里"风险评估"等词会误杀真会议邮件）
    let from_src = email.address + " " + email.subject
    if regex("noreply|no.reply|no_reply|安全通知|账号安全|密码|登录|新设备|验证|优惠|促销|广告|欢迎|security|alert|newsletter|sign in", "i").test(from_src) { return false }
    let text = email.subject + " " + email.body
    // 12 个关键词合并为单个 alternation：一次编译一次匹配（原逐词 regex 每封 12 次编译）
    if regex("会议|meeting|日程|schedule|时间|time|地点|location|邀请|invite|评审|review", "i").test(text) { return true }
    for dp in date_patterns { if text.search(dp) >= 0 { return true } }
    return false
}

fn extract_events(email) {
    let events = []
    let text = email.subject + " " + email.body
    let date = extract_date(text)
    let time = extract_time(text)
    let loc = extract_location(text)
    if date != "" || time != "" {
        events.push({title: email.subject date: date time: time location: loc source_email_id: email.id})
    }
    return events
}

fn extract_date(text) {
    for dp in date_patterns {
        if text.search(dp) >= 0 {
            // regex 捕获组在多字节文本上可能切到字符中间（引擎 slot 边界 bug），
            // 改用原生 split 取上下文窗口
            let parts = text.split(dp)
            if parts.len() >= 2 {
                let cand = take_until_any(tail_n(parts[0], 8) + dp + head_n(parts[1], 14), "，。；;、\n(（").trim()
                if valid_date(cand) { return cand }
            }
        }
    }
    return ""
}

// 日期提取有效性：必须含数字或周/今/明/后天等日历词，否则是切出来的垃圾片段
fn valid_date(s) {
    if s.len() == 0 || s.len() > 40 { return false }
    if s.search("\n") >= 0 { return false }
    return regex("[0-9]|周[一二三四五六日末]|今天|明天|后天|上午|下午|晚上", "").test(s)
}

fn extract_time(text) {
    for tp in time_patterns {
        if text.search(tp) >= 0 {
            let parts = text.split(tp)
            if parts.len() >= 2 {
                let cand = take_until_any(tail_n(parts[0], 5) + tp + head_n(parts[1], 10), "，。；;、\n(（").trim()
                if valid_time(cand) { return cand }
            }
        }
    }
    return ""
}

// 时间提取有效性：必须含数字且带时间特征字符
fn valid_time(s) {
    if s.len() == 0 || s.len() > 30 { return false }
    if s.search("\n") >= 0 { return false }
    if !regex("[0-9]", "").test(s) { return false }
    return regex("点|:|：|时|分|am|pm|上午|下午|晚上", "i").test(s)
}

fn extract_location(text) {
    // 英文关键词附常见首字母大写变体（split 是大小写敏感的原生查找）
    let kws = ["地点", "location", "Location", "在", " at ", "会议室", "room", "Room", "venue", "Venue"]
    for kw in kws {
        let parts = text.split(kw)
        if parts.len() >= 2 {
            let rest = parts[1].strip_prefix("：").strip_prefix(":").strip_prefix(" ").trim()
            let loc = take_until_any(head_n(rest, 30), "，。,\n(（").trim()
            if valid_location(loc) { return loc }
        }
    }
    return ""
}

// 地点提取有效性：含数字或场所词（"在"是高频单字，没有校验会把"潜在风险"切成"风险"）
fn valid_location(s) {
    if s.len() == 0 || s.len() > 60 { return false }
    if s.search("\n") >= 0 { return false }
    return regex("[0-9]|室|楼|座|厅|园|场|路|街|号|广场|大厦|酒店|center|park|building|hall|room|garden", "i").test(s)
}

fn make_draft(email, events, change) {
    let d = "您好，\n\n"
    if change.old != "" || change.new != "" {
        d = d + "已收到变更通知（" + change.old + " → " + change.new + "），我会按新安排执行。"
    } else if events.len() > 0 {
        d = d + "感谢邮件，我已收到以下日程信息：\n\n"
        for e in events {
            d = d + "  " + e.title + "\n"
            if e.date != "" { d = d + "    日期：" + e.date + "\n" }
            if e.time != "" { d = d + "    时间：" + e.time + "\n" }
            if e.location != "" { d = d + "    地点：" + e.location + "\n" }
        }
        d = d + "\n我会准时参加。"
    } else { d = d + "感谢来信，我会尽快回复。" }
    return d + "\n\n此致敬礼"
}

// 从正文中检测日程变更：“从 X 改为 Y”类句式；无“从”结构时只识别新值
fn extract_change(email) {
    let text = email.subject + " " + email.body
    // 主句式"从 X 改为 Y"：split 取代 regex 捕获组（引擎捕获组边界在多字节文本上有 bug）
    if text.search("从") >= 0 {
        for mk in change_markers {
            let seg = text.split(mk)
            if seg.len() >= 2 {
                let f = seg[0].split("从")
                if f.len() >= 2 {
                    let old_v = take_until_any(tail_n(f[1], 24).trim(), "，。；;、\n").trim()
                    let new_v = take_until_any(head_n(seg[1], 24).trim(), "，。；;、\n").trim()
                    if old_v.len() > 0 && new_v.len() > 0 {
                        return {old: old_v new: new_v source: ("从" + old_v + mk + new_v)}
                    }
                }
            }
        }
    }
    // 无"从"结构时只识别新值
    for mk in change_markers {
        if text.search(mk) >= 0 {
            let seg = text.split(mk)
            if seg.len() >= 2 {
                let new_v = take_until_any(head_n(seg[1], 24).trim(), "，。；;、\n").trim()
                if new_v.len() > 0 { return {old: "" new: new_v source: mk + new_v} }
            }
        }
    }
    return {old: "" new: "" source: ""}
}

// 提取 key 之后的短字段值（支持中英文冒号、行尾截断）
fn extract_after(text, key) {
    let parts = text.split(key)
    if parts.len() < 2 { return "" }
    let rest = parts[1].strip_prefix("：").strip_prefix(":").trim()
    return take_until_any(rest, "，。\n(（ ").trim()
}

fn extract_order_no(text) {
    let m = text.match_str(regex("(OS-[A-Za-z0-9]{1,12})", ""))
    if m != nil { return m.captures[1] }
    if text.search("订单号") >= 0 {
        let no = extract_after(text, "订单号")
        if no.len() > 0 { return no }
    }
    return "订单"
}

// 识别订单/物流邮件，返回 {order_no item step tracking estimated}；step=0 表示不是订单邮件
fn detect_order(email) {
    let text = email.subject + " " + email.body
    // 先用合并 alternation 预筛：非订单邮件一次 regex 即返回
    if !regex("订单|order|发货|shipped|物流|运单|tracking|快递|delivery|已寄出", "i").test(text) {
        return {order_no: "" item: "" step: 0 tracking: "" estimated: ""}
    }
    let hits = 0
    for k in order_keywords { if regex(k, "i").test(text) { hits = hits + 1 } }
    if hits >= 2 {
        let step = 1
        if regex("运输|已发货|shipped", "i").test(text) { step = 2 }
        if regex("已送达|delivered", "i").test(text) { step = 3 }
        return {order_no: extract_order_no(text) item: email.subject step: step tracking: extract_after(text, "运单号") estimated: extract_after(text, "预计送达")}
    }
    return {order_no: "" item: "" step: 0 tracking: "" estimated: ""}
}

fn order_steps_text(step) {
    let d1 = "○"
    let d2 = "○"
    let d3 = "○"
    if step >= 1 { d1 = "●" }
    if step >= 2 { d2 = "●" }
    if step >= 3 { d3 = "●" }
    return d1 + " 已下单    " + d2 + " 运输中    " + d3 + " 已送达"
}

fn step_label(step) {
    if step >= 3 { return "已送达" }
    if step >= 2 { return "运输中" }
    return "已下单"
}

fn events_text(events) {
    let t = ""
    for e in events {
        t = t + e.title + "\n"
        if e.date != "" { t = t + "  日期  " + e.date + "\n" }
        if e.time != "" { t = t + "  时间  " + e.time + "\n" }
        if e.location != "" { t = t + "  地点  " + e.location + "\n" }
    }
    return t
}

fn is_done(id) {
    for d in done_ids { if d == id { return true } }
    return false
}

fn badge_text(analysis) {
    if is_done(analysis.email.id) { return "✅ 已处理" }
    if analysis.change.old != "" { return "📅 时间变更" }
    if analysis.extracted_events.len() > 0 { return "📅 含日程" }
    if analysis.order.step > 0 { return "📦 物流更新" }
    return ""
}

fn change_summary(analysis) {
    if analysis.change.old != "" { return "日程已更新  " + analysis.change.old + " → " + analysis.change.new }
    if analysis.extracted_events.len() > 0 { return "日程已确认：" + analysis.extracted_events[0].title }
    return "已处理"
}

// 批准行动：发确认回复（真实模式走 SMTP）+ 标记完成态（对齐官方手册 Control/结果考点）
fn approve_action(always) {
    if current_email == nil { return }
    let email = current_email.email
    let draft = ui.action_draft.text()
    let note = "确认回复已发送"
    if current_email.change.old != "" {
        note = "日程已更新：" + current_email.change.old + " → " + current_email.change.new + "\n确认回复已发送"
    }
    if always {
        rules.push({sender: email.sender address: email.address})
        note = note + "\n已创建规则：来自「" + email.sender + "」的同类变更将自动确认"
    }
    if demo_mode {
        finish_approve(note + "\n（演示模式：未实际发送）")
        return
    }
    ui.action_done.set_visible(true)
    ui.action_done.set_text("发送中...")
    host.request("mail.send", {
        account: account.id to: email.address
        subject: "Re: " + email.subject body: draft
    }, fn(r) {
        if r.is_ok { finish_approve(note) }
        else { ui.action_done.set_text(r.error) }
    })
}

fn finish_approve(note) {
    let email = current_email.email
    done_ids.push(email.id)
    ui.action_title.set_text("✅ 已处理")
    if current_email.change.old != "" {
        ui.action_change_old.set_text(current_email.change.old)
        ui.action_change_arrow.set_text(" → ")
        ui.action_change_new.set_text(current_email.change.new)
    }
    ui.action_source.set_visible(false)
    ui.action_label.set_visible(false)
    ui.action_draft.set_visible(false)
    ui.action_btns.set_visible(false)
    ui.action_done.set_visible(true)
    ui.action_done.set_text(note)
    ui.email_list.render()
}

fn ignore_action() { ui.action_card.set_visible(false) }

fn open_email(analysis) {
    current_email = analysis
    let email = analysis.email
    ui.read_subject.set_text(email.subject)
    ui.read_sender.set_text(email.sender)
    ui.read_address.set_text("<" + email.address + ">")
    ui.read_avatar_text.set_text(email.avatar)
    ui.read_time.set_text(format_time_display(email.time))
    let body_text = email.body
    if body_text == "" || body_text == nil { body_text = "（正文暂未同步，仅加载了邮件头）" }
    ui.read_body.set_text(body_text)

    // 行动卡片：只有提取到有效事件或变更才显示（防"识别到日程"误报到通知类邮件）
    if analysis.has_calendar_content && (analysis.extracted_events.len() > 0 || analysis.change.old != "") {
        ui.action_card.set_visible(true)
        if is_done(email.id) {
            ui.action_title.set_text("✅ 已处理")
            ui.action_change_old.set_text(change_summary(analysis))
            ui.action_change_arrow.set_text("")
            ui.action_change_new.set_text("")
            ui.action_source.set_visible(false)
            ui.action_label.set_visible(false)
            ui.action_draft.set_visible(false)
            ui.action_btns.set_visible(false)
            ui.action_done.set_visible(true)
            ui.action_done.set_text("确认回复已发送；变更已记录到日程")
        } else {
            if analysis.change.old != "" {
                ui.action_title.set_text("📅 检测到日程变更")
                ui.action_change_old.set_text(analysis.change.old)
                ui.action_change_arrow.set_text(" → ")
                ui.action_change_new.set_text(analysis.change.new)
                ui.action_source.set_text("来源：\"" + analysis.change.source + "\"")
                ui.action_source.set_visible(true)
            } else {
                ui.action_title.set_text("📅 识别到日程，待确认")
                ui.action_change_old.set_text(events_text(analysis.extracted_events))
                ui.action_change_arrow.set_text("")
                ui.action_change_new.set_text("")
                ui.action_source.set_visible(false)
            }
            ui.action_label.set_visible(true)
            ui.action_draft.set_visible(true)
            ui.action_draft.set_text(analysis.reply_draft)
            ui.action_btns.set_visible(true)
            ui.action_done.set_visible(false)
        }
    } else {
        ui.action_card.set_visible(false)
    }

    // 订单追踪卡片
    if analysis.order.step > 0 {
        ui.order_card.set_visible(true)
        ui.order_title.set_text("订单 " + analysis.order.order_no + " · " + step_label(analysis.order.step))
        ui.order_steps.set_text(order_steps_text(analysis.order.step))
        let extra = ""
        if analysis.order.tracking != "" { extra = "运单号 " + analysis.order.tracking }
        if analysis.order.estimated != "" {
            if extra != "" { extra = extra + " · " }
            extra = extra + "预计 " + analysis.order.estimated
        }
        if extra == "" { ui.order_extra.set_visible(false) }
        else {
            ui.order_extra.set_text(extra)
            ui.order_extra.set_visible(true)
        }
    } else {
        ui.order_card.set_visible(false)
    }

    pane("reader")
}

fn compose_reply() {
    if current_email == nil { return }
    let email = current_email.email
    let subject = email.subject
    if subject.search("Re:") != 0 { subject = "Re: " + subject }
    ui.compose_to.set_text(email.address)
    ui.compose_subject.set_text(subject)
    let body_text = current_email.reply_draft
    if current_email.has_calendar_content { body_text = ui.action_draft.text() }
    ui.compose_body.set_text(body_text)
    pane("composer")
}

fn send_reply() {
    if demo_mode { ui.compose_status.set_text("演示模式 — 未实际发送"); return }
    ui.compose_status.set_text("发送中...")
    host.request("mail.send", {
        account: account.id to: ui.compose_to.text()
        subject: ui.compose_subject.text() body: ui.compose_body.text()
    }, fn(r) {
        if r.is_ok { set_status("已发送"); pane("inbox") }
        else { ui.compose_status.set_text(r.error) }
    })
}

fn back_to_inbox() { pane("inbox"); ui.email_list.render() }

fn pane(name) {
    ui.welcome.set_visible(name == "welcome")
    ui.inbox.set_visible(name == "inbox")
    ui.reader.set_visible(name == "reader")
    ui.composer.set_visible(name == "composer")
}

