// Agentic Mail v0.3 - 智能邮件助手
// 行动卡片：日程变更对比 | 来源引用 | 可编辑回复 | 授权规则 | 完成态 | 订单追踪

let account = nil
let messages = []
let analyzed_emails = []
let current_email = nil
let busy = false
let demo_mode = false
let selected_tab = "inbox"
let unread_count = 2
let done_ids = []
let rules = []

let calendar_keywords = ["会议", "meeting", "日程", "schedule", "时间", "time", "地点", "location", "邀请", "invite", "评审", "review"]
let date_patterns = ["月", "日", "号", "周一", "周二", "周三", "周四", "周五", "周六", "周日", "明天", "后天", "今天"]
let time_patterns = ["点", ":", "时", "分", "am", "pm", "上午", "下午"]
let change_markers = ["改为", "调整到", "提前到", "推迟到", "变更为", "改成"]
let order_keywords = ["订单", "order", "发货", "shipped", "物流", "运单", "tracking", "快递", "delivery", "已寄出"]

fn set_status(text) { ui.status_label.set_text(text) }

