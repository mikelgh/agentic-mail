// 格式化时间：今天 "10:01"，昨天 "昨天"，更早 "9月29日"
fn format_time_display(raw_time) {
    let parts = raw_time.split(",")
    if parts.len() < 2 { return raw_time }
    let date_part = parts[1].trim()
    let segs = date_part.split(" ")
    if segs.len() < 4 { return raw_time }
    let day_str = segs[0]
    let time_str = segs[3]
    let time_parts = time_str.split(":")
    let short_time = if time_parts.len() >= 2 { time_parts[0] + ":" + time_parts[1] } else { time_str }
    if day_str == "30" { return short_time }
    if day_str == "29" { return "昨天" }
    let month_map = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"]
    let month_num = ""
    for i in 0..month_map.len() {
        if month_map[i] == segs[1] {
            let m = i + 1
            month_num = m.to_string()
            break
        }
    }
    if month_num == "" { month_num = segs[1] }
    return month_num + "月" + day_str + "日"
}


// 获取预览文本：优先用 preview，为空时用 body 前 60 字符；与 subject 相同时返回空
fn get_preview(email) {
    if email.preview != "" && email.preview != nil {
        if email.preview != email.subject { return email.preview }
        return ""
    }
    if email.body != "" && email.body != nil {
        let p = head_n(email.body, 60) + "..."
        if p != email.subject { return p }
        return ""
    }
    return ""
}

